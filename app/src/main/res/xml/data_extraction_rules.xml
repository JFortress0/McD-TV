<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backups and device transfer. Spotify tokens never leave this TV: their file is left out. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="spotify_vault.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="spotify_vault.xml" />
    </device-transfer>
</data-extraction-rules>
